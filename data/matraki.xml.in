<?xml version="1.0" encoding="utf-8"?>
<!-- filename: matraki.xml -->
<!-- XML specification for iBus -->
<component>
    <name>org.freedesktop.IBus.MatraKi</name>
    <description>MatraKi</description>
    <exec>@PROJECT_DATADIR@/ibus-matraki --ibus</exec>
    <version>@PROJECT_VERSION@</version>
    <author>See About Dialog</author>
    <license>GPL 3</license>
    <homepage>http://matraki.github.io</homepage>
    <textdomain>matraki-keyboard</textdomain>
    <engines>
        <engine>
            <name>MatraKi</name>
            <language>bn</language>
            <license>GPL 3</license>
            <author>See AboutBox</author>
            <icon>@PROJECT_DATADIR@/icons/MatraKi.png</icon>
            <layout>default</layout>
            <longname>MatraKi</longname>
            <description>MatraKi IME for iBus</description>
            <rank>0</rank>
        </engine>
    </engines>
</component>
