  <property name="styleSheet">
   <string notr="true">QDialog#AboutDialog {
    background-color: #0b1120;
    color: #f8fafc;
    font-family: &quot;Noto Sans&quot;, sans-serif;
}
QFrame#frameHeader {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #0f172a, stop:0.5 #172554, stop:1 #0f172a);
    border: 1.5px solid #38bdf8;
    border-radius: 14px;
}
QFrame#frameFeatures {
    background-color: #131c31;
    border: 1px solid #1e293b;
    border-radius: 12px;
}
QFrame#frameShortcuts {
    background-color: #0f172a;
    border: 1px solid rgba(56, 189, 248, 0.35);
    border-radius: 10px;
}
QFrame#frameDev {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 rgba(29, 78, 216, 0.20), stop:1 rgba(14, 165, 233, 0.16));
    border: 1px solid rgba(56, 189, 248, 0.45);
    border-radius: 12px;
}
QFrame#frameDonation {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 rgba(225, 29, 72, 0.22), stop:1 rgba(244, 63, 94, 0.18));
    border: 1px solid rgba(244, 63, 94, 0.55);
    border-radius: 12px;
}
</string>
