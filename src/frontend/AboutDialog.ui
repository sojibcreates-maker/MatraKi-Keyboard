      </property>
      <item>
       <widget class="QLabel" name="labelDesc">
        <property name="text">
         <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;
&lt;p style=&quot;margin:0 0 6px 0;&quot;&gt;&lt;span style=&quot;font-size:9.2pt; color:#e2e8f0;&quot;&gt;&lt;b style=&quot;color:#38bdf8;&quot;&gt;MatraKi&lt;/b&gt; is an advanced, high-performance Bangla input method engineered for Linux desktops. Combining a blazingly fast Rust phonetic core with an intelligent C++ AI language layer, MatraKi makes writing Bengali faster, smarter, and completely effortless.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:4px 0 2px 0;&quot;&gt;&lt;span style=&quot;font-size:9.5pt; font-weight:700; color:#38bdf8;&quot;&gt;🧠 AI Phonetic &amp;amp; Language Intelligence:&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0 0 6px 8px;&quot;&gt;&lt;span style=&quot;font-size:8.8pt; color:#cbd5e1;&quot;&gt;
• &lt;b style=&quot;color:#f8fafc;&quot;&gt;Massive Trained Vocabulary:&lt;/b&gt; Pre-trained with &lt;b style=&quot;color:#34d399;&quot;&gt;15,580+&lt;/b&gt; high-frequency Bengali words, &lt;b style=&quot;color:#34d399;&quot;&gt;20,535&lt;/b&gt; auto-correct patterns, and smart agglutinative suffix stemming (&lt;i&gt;-গুলো, -দের, -টা, -টি, -কে, -তে&lt;/i&gt;).&lt;br/&gt;
• &lt;b style=&quot;color:#f8fafc;&quot;&gt;Context-Aware Next-Word Prediction:&lt;/b&gt; Suggests natural follow-up words right after pressing Space (&lt;b style=&quot;color:#38bdf8;&quot;&gt;130+&lt;/b&gt; conversational bigram contexts) and ranks verbs by subject pronoun concordance (&lt;i&gt;আমি করব, তুমি করবে, আপনি করবেন&lt;/i&gt;).&lt;br/&gt;
• &lt;b style=&quot;color:#f8fafc;&quot;&gt;Bangla Academy Spelling &amp;amp; Grammar Engine:&lt;/b&gt; Automatically corrects common Nattvabidhi, Shattvabidhi, and vowel-length errors (&lt;i&gt;সান্ত্বনা, ইতোমধ্যে, উপর্যুক্ত, শ্রদ্ধাঞ্জলি, শারীরিক, সমীচীন, মরীচিকা&lt;/i&gt;).
&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:4px 0 2px 0;&quot;&gt;&lt;span style=&quot;font-size:9.5pt; font-weight:700; color:#f43f5e;&quot;&gt;⚡ Smart Productivity &amp;amp; Instant Conversion Tools:&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0 0 2px 8px;&quot;&gt;&lt;span style=&quot;font-size:8.8pt; color:#cbd5e1;&quot;&gt;
• &lt;b style=&quot;color:#f8fafc;&quot;&gt;Live Calculator &amp;amp; Unit Converter (&lt;span style=&quot;color:#34d399;&quot;&gt;=&lt;/span&gt;):&lt;/b&gt; Evaluate math expressions (&lt;code style=&quot;color:#38bdf8;&quot;&gt;=500*15%&lt;/code&gt;, &lt;code style=&quot;color:#38bdf8;&quot;&gt;=2^10&lt;/code&gt;) and convert units instantly (&lt;code style=&quot;color:#38bdf8;&quot;&gt;=10km&lt;/code&gt;, &lt;code style=&quot;color:#38bdf8;&quot;&gt;=5kg&lt;/code&gt;, &lt;code style=&quot;color:#38bdf8;&quot;&gt;=100c&lt;/code&gt;, &lt;code style=&quot;color:#38bdf8;&quot;&gt;=98.6f&lt;/code&gt;, &lt;code style=&quot;color:#38bdf8;&quot;&gt;=5ft&lt;/code&gt;, &lt;code style=&quot;color:#38bdf8;&quot;&gt;=1bigha&lt;/code&gt;, &lt;code style=&quot;color:#38bdf8;&quot;&gt;=5katha&lt;/code&gt;).&lt;br/&gt;
• &lt;b style=&quot;color:#f8fafc;&quot;&gt;Instant Chat &amp;amp; Islamic Snippets (&lt;span style=&quot;color:#fde047;&quot;&gt;!&lt;/span&gt;):&lt;/b&gt; Type &lt;code style=&quot;color:#fde047;&quot;&gt;!salam&lt;/code&gt;, &lt;code style=&quot;color:#fde047;&quot;&gt;!olikum&lt;/code&gt;, &lt;code style=&quot;color:#fde047;&quot;&gt;!bismillah&lt;/code&gt;, &lt;code style=&quot;color:#fde047;&quot;&gt;!alhamdulillah&lt;/code&gt;, &lt;code style=&quot;color:#fde047;&quot;&gt;!inshaallah&lt;/code&gt;, or &lt;code style=&quot;color:#fde047;&quot;&gt;!shuvo&lt;/code&gt; for full Bangla &amp;amp; Arabic greetings with smart prefix matching.&lt;br/&gt;
• &lt;b style=&quot;color:#f8fafc;&quot;&gt;Smart Dates, Ordinals, Currency &amp;amp; Emojis:&lt;/b&gt; Type &lt;code style=&quot;color:#fb7185;&quot;&gt;1la&lt;/code&gt; (১লা/পহেলা), &lt;code style=&quot;color:#fb7185;&quot;&gt;21she&lt;/code&gt; (২১শে), &lt;code style=&quot;color:#fb7185;&quot;&gt;1m&lt;/code&gt; (১ম/প্রথম), &lt;code style=&quot;color:#fb7185;&quot;&gt;500tk&lt;/code&gt; (৫০০ টাকা / ৳৫০০ / পাঁচ শত টাকা), &lt;code style=&quot;color:#fb7185;&quot;&gt;@today&lt;/code&gt;, or &lt;code style=&quot;color:#fb7185;&quot;&gt;:smile&lt;/code&gt;.
&lt;/span&gt;&lt;/p&gt;
&lt;/body&gt;&lt;/html&gt;</string>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
