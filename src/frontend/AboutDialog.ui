   </item>
   <item>
    <widget class="QFrame" name="frameFeatures">
     <layout class="QVBoxLayout" name="layoutFeatures">
      <property name="spacing">
       <number>4</number>
      </property>
      <property name="leftMargin">
       <number>16</number>
      </property>
      <property name="topMargin">
       <number>12</number>
      </property>
