        <item>
         <widget class="QLabel" name="labelTitle">
          <property name="text">
           <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p style=&quot;margin:0;&quot;&gt;&lt;span style=&quot;font-size:19pt; font-weight:800; color:#ffffff;&quot;&gt;MatraKi&lt;/span&gt;&lt;span style=&quot;font-size:12.5pt; font-weight:700; color:#38bdf8;&quot;&gt;  •  AI Smart Bangla Keyboard&lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QLabel" name="labelTagline">
          <property name="text">
           <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p style=&quot;margin:0;&quot;&gt;&lt;span style=&quot;font-size:10.5pt; font-weight:700; color:#f43f5e;&quot;&gt;Type Smarter. Write Better.&lt;/span&gt;&lt;span style=&quot;font-size:9.5pt; color:#cbd5e1;&quot;&gt; — Next-Gen Phonetic &amp;amp; Fixed Layout Input Suite&lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QLabel" name="labelVer">
          <property name="text">
           <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p style=&quot;margin:2px 0 0 0;&quot;&gt;&lt;span style=&quot;color:#34d399; font-size:9pt; font-weight:700;&quot;&gt;✨ v1.0.0 (AI Smart Edition)  •  15,580+ Trained Words  •  20,535 Auto-Correct Rules  •  Fcitx5 &amp;amp; Riti Engine&lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
          </property>
         </widget>
        </item>
       </layout>
