}
QPushButton {
    background-color: #1e293b;
    color: #cbd5e1;
    border: 1px solid #334155;
    border-radius: 14px;
    padding: 6px 16px;
    font-size: 12px;
    font-weight: bold;
    outline: none;
}
QPushButton:hover {
    border-color: #38bdf8;
    color: #ffffff;
}
QPushButton:checked {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #1d4ed8, stop:1 #0ea5e9);
    color: #ffffff;
    border: 1px solid #38bdf8;
}
QPushButton:disabled {
    background-color: #0f172a;
    color: #475569;
    border-color: #1e293b;
}
QPushButton#buttonAboutLayout {
    background-color: rgba(56, 189, 248, 0.14);
    color: #38bdf8;
    border: 1px solid #38bdf8;
    border-radius: 10px;
    padding: 6px 14px;
}
QPushButton#buttonAboutLayout:hover {
    background-color: #0284c7;
    color: #ffffff;
}
QLabel#labelImage {
    background-color: #0b1120;
    border: 1px solid #1e293b;
    border-radius: 12px;
    padding: 4px;
}</string>
